prefix=/Users/yarna/Project/MoonvyRoot/products/Apps/ImageFmtBenchmark/encoder/deps/zlib-ng
exec_prefix=${prefix}
symbol_prefix=
bindir=${exec_prefix}/bin
libdir=${exec_prefix}/lib
sharedlibdir=${libdir}
includedir=${prefix}/include

Name: zlib
Description: zlib-ng compression library
Version: 1.3.2.zlib-ng

Requires:
Libs: -L${libdir} -L${sharedlibdir} -lz
Cflags: -I${includedir} -DWITH_GZFILEOP
